        "deploy:ic": "dfx deploy --network=ic",
        "generate": "dfx generate dca_agent",
        "clean": "rm -rf .dfx && rm -rf node_modules && rm -rf dist",
        "quicktest": "dfx deploy --network=local && npm start",
        "test": "echo \"Error: no test specified\" && exit 1"
